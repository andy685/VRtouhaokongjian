# 阿里云百炼凭据（本地代理服务使用）
# 复制本文件为 .env 后填写，切勿提交到仓库

# RAM 用户 AccessKey：用于调用百炼知识库 OpenAPI（CreateIndex / AddFile / Retrieve 等）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 百炼业务空间 ID（控制台「业务空间管理」获取，形如 ws_xxxx 或 llm-xxxx）
WORKSPACE_ID=

# 可选：服务接入点，默认 bailian.cn-beijing.aliyuncs.com
BAILIAN_ENDPOINT=bailian.cn-beijing.aliyuncs.com

# 可选：跨知识库检索（需在控制台创建并发布「知识检索」服务后取得 agent_id）
DASHSCOPE_API_KEY=
BAILIAN_AGENT_ID=

# 可选：代理服务端口，默认 9610
BAILIAN_PROXY_PORT=9610
